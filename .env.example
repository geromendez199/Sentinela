# ---------------------------------------------------------------------------
# Sentinela ML - environment contract. Never commit real values.
# `npm run verify:env` fails the build when a required variable is missing.
# ---------------------------------------------------------------------------

# --- Public (browser) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# 2026 key model: publishable key in the browser. Never the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=https://app.sentinela.example

# --- Server only -----------------------------------------------------------
# Privileged backend key (2026 replacement for service_role).
SUPABASE_SECRET_KEY=sb_secret_xxx

# MercadoLibre application credentials. Backend only; never exposed to client.
MELI_APP_ID=0000000000000000
MELI_CLIENT_SECRET=xxx
# Must match the URI registered in the MercadoLibre application, exactly.
MELI_REDIRECT_URI=https://app.sentinela.example/api/integrations/meli/callback
# Enable PKCE only when the MercadoLibre application has it enabled.
MELI_PKCE_ENABLED=false

# Unguessable suffix of the webhook route handled by the meli-webhook Edge Function.
MELI_WEBHOOK_ROUTE_SECRET=change-me

# Single allowed LLM/embeddings provider. Abstracted behind lib/ai/provider.ts.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Single allowed outbound notification provider.
NOTIFICATIONS_PROVIDER=none
NOTIFICATIONS_API_KEY=

# Global kill switch for every MercadoLibre write. MVP ships with writes disabled.
MELI_WRITES_ENABLED=false
